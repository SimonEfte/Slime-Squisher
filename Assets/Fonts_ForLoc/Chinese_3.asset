    characterSequence: "\u5BF9\u6297\u53F2\u83B1\u59C6\u5546\u5E97\r\n\u53EF\u7528:
      700\r\n\u9009\u62E9\u4E00\u6B21\u5347\u7EA7\r\n\u6700\u5927\u503C\r\n\u91D1\u5E01\u6389\u843D\u51E0\u7387\r\u589E\u52A0\u8E22\u51FA\u7684\u5B50\u5F39\u4F24\u5BB3\u4ECE\u5230\n\u521D\u59CB\u70B9\u51FB\u4F24\u5BB3\r\n\u521D\u59CB\u751F\u547D\u503C\r\n\u66B4\u51FB\u51E0\u7387\u548C\u66B4\u51FB\u52A0\u6210\r\n10%\u548C190%\r\n\u521D\u59CB\u70B9\u51FB\u51B7\u5374\r\n\u6BCF4\u6CE2\r\n\u6062\u590D\u534A\u9897\u5FC3\r\n\u66F4\u591A\u5347\u7EA7\u69FD\r\n\u91CD\u65B0\u9009\u62E9\r\n\u53D7\u4F24\u540E\u83B7\u5F97\u65E0\u654C\u72B6\u6001\r\n\u66F4\u591A\u5347\u7EA7\u9009\u62E9\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\u65F6/\u53F2\u83B1\u59C6\u6B7B\u4EA1\u65F6\u89E6\u53D1\u51E0\u7387\r\n\u6240\u6709\u4F24\u5BB3\u52A0\u6210\r\n\u66F4\u4F18\u4E3B\u52A8\u80FD\u529B\r\n\u7B49\u7EA72\r\n\u8F83\u6162\u7684\u53F2\u83B1\u59C6\r\n\u8F83\u6162\u7684\u53F2\u83B1\u59C6\u5B50\u5F39\r\n\u670950%\u7684\u51E0\u7387\u5728\u63A5\u4E0B\u6765\u76844\u79D2\u5185\u89E6\u53D1\u6240\u6709\u201C\u70B9\u51FB\u53F2\u83B1\u59C6\u65F6\u201D\u548C\u201C\u53F2\u83B1\u59C6\u6B7B\u4EA1\u65F6\u201D\u5347\u7EA7\u3002\u6BCF3\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n\u5956\u52B1\uFF1A\r\n\u589E\u52A0\u6240\u6709\u201C\u70B9\u51FB\u53F2\u83B1\u59C6\u65F6\u201D\u548C\u201C\u53F2\u83B1\u59C6\u6B7B\u4EA1\u65F6\u201D\u5347\u7EA7\u7684\u51E0\u7387\u6765\u89E6\u53D1\r\n\u91CD\u65B0\u9009\u62E9\r\n\u91CD\u65B0\u9009\u62E9\u4F60\u7684\u5347\u7EA7\u3002\u5269\u4F593\u6B21\r\n\u523A\u5200\r\n\u5F53\u53F2\u83B1\u59C6\u9760\u8FD1\u8349\u8393\u65F6\uFF0C\u8349\u8393\u4F1A\u63E1\u7740\u523A\u5200\u6BCF3\u79D2\u523A\u6740\u53F2\u83B1\u59C6\u4E00\u6B21\uFF0C\u9020\u62107\u70B9\u4F24\u5BB3\r\n\u523A\u5200\u7684\u4F24\u5BB3\u4ECE7\u70B9\u63D0\u9AD8\u52309\u70B9\r\n\u9ECF\u6DB2\u5C16\u523A\r\n\u5F53\u53F2\u83B1\u59C6\u88AB\u7C89\u788E\u6389\u65F6\uFF0C\u53F2\u83B1\u59C6\u9ECF\u6DB2\u4F1A\u4EA7\u751F\u4E00\u4E2A\u5C0F\u5C16\u523A\u3002\u5C16\u523A\u9020\u62102\u70B9\u4F24\u5BB3\u5E76\u6301\u7EED\u5230\u9ECF\u6DB2\u6D88\u5931\u4E3A\u6B62\r\n\u5C16\u523A\u7684\u4F24\u5BB3\u4ECE2\u70B9\u63D0\u9AD8\u52303\u70B9\r\n\u5927\u578B\u6FC0\u5149\u67AA\r\n\u8349\u8393\u8F68\u9053\uFF1A\u4E00\u628A\u5927\u578B\u6FC0\u5149\u67AA\u4F1A\u56F4\u7ED5\u8349\u8393\u65CB\u8F6C\uFF0C\u6BCF5\u79D2\u53D1\u5C04\u4E00\u6B21\u5927\u675F\u6FC0\u5149\u3002\u6FC0\u5149\u9020\u62105\u70B9\u4F24\u5BB3\u5E76\u6E05\u9664\u654C\u4EBA\u7684\u5B50\u5F39\r\n\u6FC0\u5149\u53D1\u5C04\u65F6\u95F4\u4ECE5\u79D2\u51CF\u5C11\u52304.5\u79D2\uFF0C\u5927\u675F\u6FC0\u5149\u4F24\u5BB3\u4ECE5\u79D2\u589E\u52A0\u52306\u79D2\r\n\u94C1\u7827\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5F15\u53D1\u4E00\u4E2A\u4ECE\u5929\u800C\u964D\u7684\u94C1\u7827\uFF0C\u5BF9\u5927\u7247\u533A\u57DF\u5185\u7684\u53F2\u83B1\u59C6\u9020\u62109\u70B9\u4F24\u5BB3\u3002\u7784\u51C6\u5C04\u51FB\uFF0C\u53EF\u4F24\u5BB3\u5927\u4E2A\u53F2\u83B1\u59C6\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u94C1\u7827\u4F24\u5BB3\u4ECE9\u70B9\u63D0\u9AD8\u523011\u70B9\r\n\u82E6\u65E0\r\n\u51FB\u6740\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5C04\u51FA2\u4E2A\u7784\u51C6\u968F\u673A\u53F2\u83B1\u59C6\u7684\u82E6\u65E0\uFF0C\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u4E5F\u670912%\u7684\u51E0\u7387\u77AC\u95F4\u51FB\u6740\u53F2\u83B1\u59C6\uFF08\u53F2\u83B1\u59C6\u9996\u9886\u9664\u5916\uFF09\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u82E6\u65E0\u4F24\u5BB3\u4ECE3\u70B9\u63D0\u9AD8\u52304\u70B9\uFF0C\u77AC\u95F4\u51FB\u6740\u51E0\u7387\u4ECE12%\u63D0\u9AD8\u523015%\r\n\u5C16\u523A\u76FE\r\n\u8349\u8393\u8F68\u9053\uFF1A\u5C0F\u5C16\u523A\u76FE\u4F1A\u56F4\u7ED5\u8349\u8393\u65CB\u8F6C\uFF0C\u963B\u6321\u5B50\u5F39\u5E76\u5BF9\u53F2\u83B1\u59C6\u9020\u62103\u70B9\u4F24\u5BB3\r\n\u589E\u52A0\u5C16\u523A\u76FE\u7684\u5C3A\u5BF8\uFF0C\u5C16\u523A\u76FE\u4F24\u5BB3\u4ECE3\u70B9\u63D0\u9AD8\u52304\u70B9\r\n\u53CB\u519B\u5B50\u5F39\r\n\u5C04\u51FB\u53F2\u83B1\u59C6\u6709\u51E0\u7387\u5C04\u51FA\u53CB\u519B\u5B50\u5F39\u3002\u53CB\u519B\u5B50\u5F39\u4F1A\u968F\u673A\u7784\u51C6\u4E00\u4E2A\u53F2\u83B1\u59C6\uFF0C\u9020\u62107\u70B9\u4F24\u5BB3\r\n\u53CB\u519B\u5B50\u5F39\u4F24\u5BB3\u4ECE7\u70B9\u63D0\u9AD8\u52309\u70B9\r\n\u952F\u7247\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5C04\u51FA1-3\u4E2A\u65CB\u8F6C\u952F\u7247\u3002\u6BCF\u4E2A\u952F\u7247\u4ECE\u5C4F\u5E55\u4E00\u4FA7\u952F\u52A8\u5230\u53E6\u4E00\u4FA7\uFF0C\u5272\u6389\u6240\u6709\u53F2\u83B1\u59C6\u5E76\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u952F\u7247\u4F24\u5BB3\u4ECE3\u70B9\u63D0\u9AD8\u52305\u70B9\r\n\u6B66\u58EB\u5200\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u751F\u4EA7\u4E00\u628A\u6B66\u58EB\u5200\uFF0C\u6B66\u58EB\u5200\u4F1A\u5212\u51FA\u4E00\u4E2A\u5706\u5708\u5E76\u5411\u968F\u673A\u65B9\u5411\u5C04\u51FA\uFF0C\u9020\u62105\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u6B66\u58EB\u5200\u4F24\u5BB3\u4ECE5\u70B9\u63D0\u9AD8\u52307\u70B9\r\n\u94FE\u5F0F\u5200\r\n\u8349\u8393\u8F68\u9053\uFF1A\u9644\u5728\u94FE\u6761\u4E0A\u7684\u5200\u7247\u4F1A\u56F4\u7ED5\u8349\u8393\u65CB\u8F6C\uFF0C\u9020\u62102\u70B9\u5931\u8840\u4F24\u5BB3\u5E76\u6301\u7EED3\u79D2\u3002\u5200\u7247\u67099%\u7684\u51E0\u7387\u77AC\u95F4\u51FB\u6740\u53F2\u83B1\u59C6\uFF08\u53F2\u83B1\u59C6\u9996\u9886\u9664\u5916\uFF09\r\n\u94FE\u5F0F\u5200\u7684\u5931\u8840\u4F24\u5BB3\u4ECE2\u70B9\u63D0\u9AD8\u52303\u70B9\uFF0C\u77AC\u95F4\u51FB\u6740\u51E0\u7387\u4ECE9%\u63D0\u9AD8\u523011%\u3002\u65CB\u8F6C\u901F\u5EA6\u4E5F\u4F1A\u63D0\u9AD8\r\n\u5C04\u9489\u67AA\r\n\u8349\u8393\u8F68\u9053\uFF1A\u6BCF1\u79D2\u5C04\u51FA\u4E00\u9897\u9489\u5B50\uFF0C\u9020\u62102\u70B9\u5931\u8840\u4F24\u5BB3\u5E76\u6301\u7EED3\u79D2\u3002\u88AB\u9489\u5B50\u51FB\u4E2D\u540E\u53F2\u83B1\u59C6\u7684\u79FB\u52A8\u901F\u5EA6\u4F1A\u964D\u4F4E30%\r\n\u5C04\u9489\u67AA\u5931\u8840\u4F24\u5BB3\u4ECE2\u70B9\u63D0\u9AD8\u52303\u70B9\uFF0C\u5C04\u9489\u67AA\u5C04\u51FB\u65F6\u95F4\u4ECE1\u79D2\u7F29\u77ED\u52300.9\u79D2\uFF0C\u51CF\u901F\u4ECE30%\u63D0\u9AD8\u523035%\r\n\u6355\u718A\u5668\r\n\u51FB\u6740\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u6295\u63B7\u4E00\u4E2A\u6355\u718A\u5668\uFF0C\u53EF\u9020\u62107\u70B9\u4F24\u5BB3\u5E76\u4F7F\u8D70\u8FC7\u7684\u53F2\u83B1\u59C6\u660F\u8FF72\u79D2\u3002\u53F2\u83B1\u59C6\u4ECE\u6355\u718A\u5668\u4E0A\u9762\u8D70\u8FC7\u540E\u6355\u718A\u5668\u624D\u4F1A\u6D88\u5931\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u6355\u718A\u5668\u4F24\u5BB3\u4ECE7\u70B9\u63D0\u9AD8\u52309\u70B9\uFF0C\u660F\u8FF7\u65F6\u95F4\u4ECE2\u79D2\u63D0\u9AD8\u52302.6\u79D2\r\n\u5E26\u523A\u539F\u6728\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u751F\u6210\u4E00\u4E2A\u671D\u968F\u673A\u65B9\u5411\u79FB\u52A8\u7684\u5E26\u523A\u5927\u5706\u6728\u3002\u5706\u6728\u4F1A\u523A\u7A7F\u6240\u6709\u53F2\u83B1\u59C6\u5E76\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u5706\u6728\u4F24\u5BB3\u4ECE3\u70B9\u63D0\u9AD8\u52305\u70B9\r\n\u8349\u8393\u817F\r\n\u8349\u8393\u4F1A\u5F97\u5230\u4E00\u53CC\u817F\u3002\u8349\u8393\u817F\u6709\u51E0\u7387\u8E22\u5230\u53F2\u83B1\u59C6\u5B50\u5F39\uFF0C\u4ECE\u800C\u6D88\u9664\u5B50\u5F39\u6216\u628A\u5B50\u5F39\u8E22\u56DE\u53F2\u83B1\u59C6\uFF0C\u9020\u62107\u70B9\u4F24\u5BB3\u3002\u8349\u8393\u817F\u4E5F\u6709\u5C0F\u51E0\u7387\u5E2E\u52A9\u8349\u8393\u907F\u5F00\u4F24\u5BB3\r\n\u633A\u8FC7\u4E00\u6CE2\u53C8\u4E00\u6CE2\u7684\u81F4\u547D\u53F2\u83B1\u59C6\u653B\u51FB\r\n\u6536\u96C6\u91D1\u5E01\u5E76\u8D2D\u4E70\u5347\u7EA7\r\n\u8BA9\u53F2\u83B1\u59C6\u5F7B\u5E95\u73A9\u5B8C\r\n\u4E0D\u60DC\u4E00\u5207\u4EE3\u4EF7\u4FDD\u62A4\u4F60\u7684\u8349\u8393\uFF01\u6BCF\u4E00\u6CE2\u90FD\u4F1A\u8BA9\u4F60\u53D8\u5F97\u66F4\u5F3A\u5927\uFF0C\u5E76\u6700\u7EC8\u8BA9\u53F2\u83B1\u59C6\u5F7B\u5E95\u73A9\u5B8C\uFF01\r\n\u6311\u6218\r\n\u5DF2\u5B8C\u6210\u7684\u6E38\u620F\u6A21\u5F0F\uFF1A\r\n\u7B80\u5355\r\n\u6B63\u5E38\r\n\u56F0\u96BE\r\n\u5F39\u5E55\r\n\u95EA\u5149\r\n\u8106\u5F31\r\n\u72C2\u66B4\r\n\u5B8C\u6210\u5956\u52B1\uFF1A\r\n\u5DF2\u6536\u96C6\u91D1\u5E01\uFF1A\r\n\u91D1\u5E01\u603B\u6570\uFF1A\r\n\u6210\u7EE9\uFF1A\r\n\u5DF2\u5B8C\u6210\u6CE2\u6570\uFF1A\r\n\u5F85\u6218\u6597\u6CE2\u6570\uFF1A\r\n\u5DF2\u5B8C\u6210\u65F6\u95F4\uFF1A\r\n\u5F85\u5B8C\u6210\u65F6\u95F4\uFF1A\r\n\u8106\u5F31\u6311\u6218\uFF1A\u8349\u8393\u57281\u6B21\u653B\u51FB\u540E\u9635\u4EA1\u3002\u751F\u547D\u503C\u5347\u7EA7\u5C06\u4E0D\u4F1A\u51FA\u73B0\u3002\u633A\u8FC715\u6CE2\u653B\u51FB\r\n\u4EF7\u683C\uFF1A
      \r\n\u62B5\u6D88\uFF01 !\"#%&'()+,-./0123456789:=ABDFILRS\\bnos\xA4\xA8\u201C\u201D\u3001\u3002\u300A\u300B\u4E00\u4E0A\u4E0B\u4E0D\u4E24\u4E2A\u4E2D\u4E3B\u4E45\u4E50\u4E5F\u4E86\u4E8E\u4E9B\u4EA1\u4EBA\u4ECE\u4EE5\u4F1A\u4F24\u4F46\u4F4D\u4F4F\u4F60\u4F7F\u4F9B\u4FDD\u503C\u505C\u5143\u5145\u5149\u5165\u5168\u5173\u5176\u5177\u5185\u518D\u51B2\u51B7\u51C6\u51CF\u51E0\u51FA\u51FB\u5200\u5206\u521B\u5229\u5230\u523A\u524D\u5251\u529B\u529F\u52A0\u52A8\u533A\u5347\u534A\u5355\u5373\u5374\u53C8\u53D1\u53D7\u53E6\u53EA\u53EF\u53F2\u53F3\u5404\u5408\u540C\u540D\u5411\u5417\u5426\u542F\u547D\u548C\u5668\u56DE\u56F0\u56F4\u5728\u5730\u5747\u5757\u57DF\u589E\u58F0\u5904\u5916\u591A\u5927\u5929\u59C6\u59CB\u5B50\u5B83\u5B8C\u5BB3\u5BF9\u5C04\u5C06\u5C0F\u5C11\u5C1D\u5C4F\u5C55\u5DE8\u5DF1\u5DF2\u5E01\u5E38\u5E76\u5EA6\u5EFA\u5F00\u5F0F\u5F31\u5F39\u5F3A\u5F53\u5F62\u5F97\u5FA1\u5FEB\u6027\u60AC\u611F\u613F\u6162\u620F\u6210\u6218\u6240\u624D\u628A\u6297\u62A4\u62E9\u6301\u6311\u6321\u633A\u6389\u63A5\u63D0\u649E\u652F\u653B\u653E\u6548\u654C\u6559\u6570\u6574\u65A9\u65CB\u65F6\u6613\u661F\u662F\u6655\u666E\u666F\u6682\u66B4\u66F4\u6700\u6709\u671B\u672C\u673A\u6740\u675F\u6765\u679A\u679C\u67AA\u6807\u6837\u6839\u683C\u69FD\u6A21\u6A2A\u6B21\u6B3E\u6B62\u6B7B\u6BCF\u6BD2\u6C38\u6CD5\u6CE2\u6D41\u6D88\u6E05\u6E38\u6EDA\u6EE1\u6F14\u6FC0\u706D\u70AE\u70B9\u7247\u7248\u7279\u72B6\u72C2\u72ED\u72F1\u7387\u73A9\u73B0\u7403\u74E2\u751F\u7528\u75AF\u7684\u76EE\u76F4\u76FE\u7729\u7740\u7784\u77AC\u77ED\u77F3\u788E\u793A\u79BB\u79CD\u79D2\u79FB\u7A0B\u7A7F\u7A84\u7B28\u7B2C\u7B80\u7BAD\u7C89\u7EA7\u7EB8\u7EC4\u7EC8\u7ED3\u7ED5\u7EED\u7F13\u7F29\u7F6E\u8003\u8005\u800C\u8017\u80CC\u80DC\u80FD\u8106\u81EA\u81F3\u81F4\u8272\u8349\u836F\u8393\u83B1\u83B7\u83DC\u843D\u85E4\u8651\u866B\u884C\u88AB\u8981\u89C4\u89E6\u8A00\u8BA9\u8BBE\u8BD5\u8BED\u8BF1\u8BF7\u8C22\u8DF3\u8F68\u8F6C\u8F83\u8FA8\u8FC7\u8FD4\u8FD8\u8FD9\u8FDB\u8FDC\u9000\u9009\u901A\u901F\u9020\u9053\u90FD\u91CC\u91CD\u91CF\u91D1\u9489\u949F\u94FE\u951A\u952E\u9556\u9570\u957F\u95EA\u95ED\u95F4\u9632\u9635\u963B\u964D\u9664\u968F\u96BE\u96E8\u975E\u97F3\u9879\u9897\u98DE\u9975\u9AD8\uFF01\uFF08\uFF09\uFF0C\uFF1A\uFF1F\u7B2C1\u6CE2\u653B\u51FB\r\n\u66B4\u51FB!
      \r\n\u5173\u95ED\r\n\u8FD4\u56DE\r\n\u662F\u5426\u8981\u91CD\u7F6E\u5F53\u524D\u56DE\u5408\uFF1F\r\n\u56DE\u5230\u4E3B\u83DC\u5355\u5417\uFF1F\u8FD9\u4F1A\u7ED3\u675F\u4F60\u5F53\u524D\u7684\u56DE\u5408\r\n\u6807\u51C6\u6E38\u620F\u6A21\u5F0F\uFF1A\u96BE\u6613\u7A0B\u5EA6
      - \u7B80\u5355\\n\u633A\u8FC725\u6CE2\u653B\u51FB\r\n\u6807\u51C6\u6E38\u620F\u6A21\u5F0F\uFF1A\u96BE\u6613\u7A0B\u5EA6
      -\u666E\u901A\u3002\u6709\u4E9B\u53F2\u83B1\u59C6\u66F4\u5FEB\u3002\u53F2\u83B1\u59C6\u5B50\u5F39\u901F\u5EA6\u66F4\u5FEB\r\n\u6807\u51C6\u6E38\u620F\u6A21\u5F0F\uFF1A\u96BE\u6613\u7A0B\u5EA6
      -\u56F0\u96BE\u3002\u6240\u6709\u7684\u53F2\u83B1\u59C6\u90FD\u66F4\u5FEB\uFF0C\u5C04\u51FB\u53F2\u83B1\u59C6\u7684\u6B21\u6570\u66F4\u591A\uFF0C\u8349\u8393\u53D7\u4F24\u65F6\u8981\u6D88\u80171\u4E2A\u6EE1\u683C\u751F\u547D\u503C\u3002\r\n\u5B50\u5F39\u5730\u72F1\u6311\u6218\uFF1A\u53EA\u6709\u5C04\u51FB\u53F2\u83B1\u59C6\u624D\u53EF\u4EE5\u751F\u6210\u3002\u5B50\u5F39\u98DE\u5C04\u901F\u5EA6\u66F4\u6162\u3002\u6709\u66F4\u9AD8\u51E0\u7387\u51FA\u73B0\u80FD\u963B\u6321\u5B50\u5F39\u7684\u5347\u7EA7\u9053\u5177\u3002\u633A\u8FC720\u6CE2\u653B\u51FB\r\n\u5FEB\u95EA\u6311\u6218:
      \u53EA\u6709\u5FEB\u901F\u53F2\u83B1\u59C6\u624D\u53EF\u4EE5\u751F\u6210\u3002\u6709\u66F4\u9AD8\u51E0\u7387\u51FA\u73B0\u80FD\u51CF\u7F13\u53F2\u83B1\u59C6\u901F\u5EA6\u7684\u5347\u7EA7\u9053\u5177\u3002\u633A\u8FC725\u6CE2\u653B\u51FB\r\n\u8106\u5F31\u6311\u6218:
      \u8349\u8393\u4E00\u51FB\u5373\u6B7B\u3002\u4E0D\u4F1A\u51FA\u73B0\u9632\u5FA1\u6027\u5347\u7EA7\u3002\u633A\u8FC715\u6CE2\u653B\u51FB\r\n\u72ED\u7A84\u6311\u6218:
      \u6E38\u620F\u533A\u57DF\u66F4\u5C0F\u3002\u633A\u8FC730\u6CE2\u653B\u51FB\r\n\u6A2A\u51B2\u76F4\u649E\u6311\u6218:
      \u53EA\u67091\u6CE2\u957F\u653B\u51FB\u3002\u6BCF15\u79D2\u5C06\u51FA\u73B0\u4E00\u6B21\u5347\u7EA7\uFF0C\u4F46\u6E38\u620F\u4E0D\u4F1A\u6682\u505C\uFF08\u53F2\u83B1\u59C6\u5B50\u5F39\u4F1A\u505C\u6B62\u5C04\u51FB\uFF09\u3002\u633A\u8FC715\u5206\u949F\u3002\r\n\u6F14\u793A\u7248\u672C\u4E2D\u4E0D\u80FD\u73A9\r\n(\u9009\u4E2D)\r\n\u51FB\u6740\u53F2\u83B1\u59C6\r\n\u77AC\u95F4\u968F\u673A\u51FB\u67405\u4E2A\u53F2\u83B1\u59C6\u3002\u6BCF4\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n\u5F3A\u529B\u70B9\u51FB\r\n\u6240\u6709\u70B9\u51FB\u5747\u5177\u6709\u66B4\u51FB\u6548\u679C\uFF0C\u5145\u80FD\u65F6\u95F4\u7F29\u77ED\u81F30.1\u79D2\uFF0C\u6301\u7EED3\u79D2\u3002\u6BCF4\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n\u9053\u5177\r\n\u6240\u6709\u201C\u70B9\u51FB\u53F2\u83B1\u59C6\u201D\u548C\u201C\u51FB\u6740\u53F2\u83B1\u59C6\u201D\u7684\u5347\u7EA7\u59CB\u7EC8\u5728\u4F1A\u63A5\u4E0B\u6765\u76843\u79D2\u5185\u89E6\u53D1\u3002\u6BCF3\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n\u8349\u8393\u8BF1\u9975\r\n\u653E\u4E0B\u4E00\u4E2A\u8349\u8393\u8BF1\u9975\u3002\u6240\u6709\u7684\u53F2\u83B1\u59C6\u90FD\u4F1A\u7784\u51C6\u8BF1\u9975\u3002\u8BF1\u9975\u6301\u7EED3\u6CE2\uFF0C\u9664\u975E\u5B83\u53D7\u5230\u4E00\u6B21\u4F24\u5BB3\u800C\u9635\u4EA1\u3002\u6BCF6\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n\u75AF\u72C2\u70AE\u5F39\r\n\u4ECE\u5149\u6807\u5904\u968F\u673A\u53D1\u5C0420\u679A\u70AE\u5F39\uFF0C\u6301\u7EED3\u79D2\u3002\u6BCF4\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n\u5BF9\u6297\u53F2\u83B1\u59C6\u5B50\u5F39\r\n\u4ECE\u8349\u8393\u4E2D\u5C04\u51FA15\u9897\u5BF9\u6297\u53F2\u83B1\u59C6\u5B50\u5F39\u3002\u6BCF\u9897\u5B50\u5F39\u9020\u621010\u70B9\u4F24\u5BB3\uFF0C\u670910%\u7684\u51E0\u7387\u77AC\u95F4\u51FB\u6740\u4E00\u540D\u654C\u4EBA\uFF08boss\u9664\u5916\uFF09\u3002\u6BCF2\u6CE2\u53EF\u5145\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\r\n2\u7EA7\r\n\u4F60\u5DF2\u633A\u8FC710\u6CE2\u653B\u51FB\uFF01\r\n\u70B9\u51FB\u51B7\u5374\r\n\u70B9\u51FB\u51B7\u5374\u65F6\u95F4\u4ECE0.8\u79D2\u7F29\u77ED\u81F30.7\u79D2\r\n\u70B9\u51FB\u4F24\u5BB3\r\n\u70B9\u51FB\u4F24\u5BB3\u4ECE10\u63D0\u9AD8\u523012\r\n\u66B4\u51FB\u4F24\u5BB3\r\n\u5C06\u66B4\u51FB\u7387\u4ECE0%\u63D0\u9AD8\u523010%\u3002\u66B4\u51FB\u4F24\u5BB3\u4ECE0%\u63D0\u9AD8\u5230200%\r\n\u8349\u8393\u751F\u547D\u503C\r\n\u8349\u8393\u751F\u547D\u503C\u589E\u52A0\u4E00\u534A\r\n\u4F24\u5BB3\u503C\u589E\u52A0\r\n\u4F7F\u6240\u6709\u4F24\u5BB3\u503C\u63D0\u9AD83%\r\n\u4F7F\u6240\u6709\u4F24\u5BB3\u503C\u4ECE3%\u63D0\u9AD8\u52306%\r\n\u74E2\u866B\r\n\u589E\u52A0\u6240\u6709\u201C\u70B9\u51FB\u53F2\u83B1\u59C6\u201D\u548C\u201C\u51FB\u6740\u53F2\u83B1\u59C6\u201D\u5347\u7EA7\u7684\u89E6\u53D1\u7387\r\n\u5149\u6807\u65A9\u51FB\r\n\u5C06\u5149\u6807\u79FB\u5230\u53F2\u83B1\u59C6\u4E0A\u8FDB\u884C\u65A9\u51FB\u3002\u6BCF\u6B21\u65A9\u51FB\u9020\u62101\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u5149\u6807\u65A9\u51FB\u7684\u4F24\u5BB3\u503C\u4ECE1\u63D0\u9AD8\u52301.5\r\n\u7EB8\u98DE\u673A\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5411\u968F\u673A\u4E00\u4E2A\u53F2\u83B1\u59C6\u53D1\u5C04\u7EB8\u98DE\u673A\uFF0C\u9020\u62108\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u7EB8\u98DE\u673A\u7684\u4F24\u5BB3\u503C\u4ECE8\u63D0\u9AD8\u523011\r\n\u7BAD\u96E8\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u53D1\u5C044-7\u652F\u4ECE\u5929\u800C\u964D\u7684\u7BAD\uFF0C\u6BCF\u652F\u7BAD\u968F\u673A\u7784\u51C6\u53F2\u83B1\u59C6\uFF0C\u5C04\u4E2D\u53F2\u83B1\u59C6\u53EF\u9020\u62104\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u7BAD\u7684\u4F24\u5BB3\u503C\u4ECE4\u63D0\u9AD8\u52305\r\n\u523A\u5200\r\n\u5149\u6807\u8F68\u9053:
      \u4E00\u628A\u56F4\u7ED5\u5149\u6807\u65CB\u8F6C\u7684\u523A\u5200\uFF0C\u5BF9\u53F2\u83B1\u59C6\u9020\u62101\u70B9\u4F24\u5BB3\u3002\u8FD9\u628A\u5200\u6BCF3\u79D2\u4F1A\u523A\u4E2D\u4E00\u4E2A\u53F2\u83B1\u59C6\u5E76\u9020\u62107\u70B9\u4F24\u5BB3\uFF0C\u5E76\u6709\u53EF\u80FD\u523A\u7A7F\u53F2\u83B1\u59C6\r\n\u523A\u5200\u7684\u4F24\u5BB3\u4ECE1\u63D0\u9AD8\u52301.2\uFF0C\u5200\u523A\u7684\u4F24\u5BB3\u503C\u4ECE7\u63D0\u9AD8\u52309\r\n\u9570\u5200\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u751F\u6210\u4E00\u628A\u6301\u7EED3\u79D2\u7684\u65CB\u8F6C\u9570\u5200\uFF0C\u6BCF\u79D2\u9020\u62105\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u9570\u5200\u7684\u6BCF\u79D2\u4F24\u5BB3\u503C\u4ECE5\u63D0\u9AD8\u52306\r\n\u6FC0\u5149\u67AA\r\n\u8349\u8393\u8F68\u9053:
      \u6FC0\u5149\u67AA\u4F1A\u56F4\u7ED5\u8349\u8393\u65CB\u8F6C\uFF0C\u6BCF1.2\u79D2\u53D1\u5C04\u4E00\u6B21\u6FC0\u5149\uFF0C\u5BF9\u53F2\u83B1\u59C6\u9020\u621010\u70B9\u4F24\u5BB3\u3002\u6FC0\u5149\u53EF\u4EE5\u51FB\u7A7F\u5E76\u6D88\u706D\u654C\u4EBA\u7684\u5B50\u5F39\u3002\u67097%\u7684\u51E0\u7387\u5C04\u51FB\u4E24\u6B21\r\n\u6FC0\u5149\u7684\u4F24\u5BB3\u503C\u4ECE10\u63D0\u9AD8\u523012\u3002\u6FC0\u5149\u5C04\u51FB\u65F6\u95F4\u4ECE1.2\u79D2\u7F29\u77ED\u81F31\u79D2\uFF0C\u4E24\u6B21\u5C04\u51FB\u7684\u51E0\u7387\u4ECE7%\u589E\u52A0\u523011%
      \r\n\u5229\u5251\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u751F\u6210\u4E00\u628A\u5229\u5251\uFF0C\u53EF\u968F\u673A\u65A9\u51FB\u53F2\u83B1\u59C66\u6B21\uFF0C\u6BCF\u6B21\u65A9\u51FB\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u5229\u5251\u65A9\u51FB\u7684\u4F24\u5BB3\u503C\u4ECE3\u63D0\u9AD8\u52304\r\n\u6BD2\u9556\r\n\u51FB\u6740\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5C04\u51FA\u4E00\u652F\u6BD2\u9556\uFF0C\u53EF\u9020\u62108\u70B9\u4F24\u5BB3+1\u70B9\u6BD2\u836F\u4F24\u5BB3\uFF0C\u6301\u7EED4\u79D2\u3002\u6BD2\u9556\u7684\u76EE\u6807\u662F\u79BB\u8349\u8393\u8F83\u8FDC\u7684\u53F2\u83B1\u59C6\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u6BD2\u9556\u7684\u4F24\u5BB3\u503C\u4ECE8\u63D0\u9AD8\u52309\uFF0C\u6BD2\u836F\u4F24\u5BB3\u4ECE1\u63D0\u9AD8\u52301.2\r\n\u8349\u8393\u62A4\u76FE\r\n\u8349\u8393\u8F68\u9053:
      \u62A4\u76FE\u4F1A\u56F4\u7ED5\u8349\u8393\u65CB\u8F6C\uFF0C\u6321\u4F4F\u5C04\u6765\u7684\u53F2\u83B1\u59C6\u5B50\u5F39\r\n\u589E\u52A0\u62A4\u76FE\u7684\u5927\u5C0F\r\n\u94FE\u5F0F\u70AE\u5F39\r\n\u8349\u8393\u8F68\u9053:
      \u94FE\u5F0F\u70AE\u5F39\u4F1A\u7ED5\u7740\u8349\u8393\u65CB\u8F6C\uFF0C\u5BF9\u53F2\u83B1\u59C6\u9020\u62104\u70B9\u4F24\u5BB3\r\n\u94FE\u5F0F\u70AE\u5F39\u7684\u4F24\u5BB3\u503C\u4ECE4\u63D0\u9AD8\u52305\uFF0C\u540C\u65F6\u63D0\u9AD8\u65CB\u8F6C\u901F\u5EA6\r\n\u85E4\u523A\r\n\u51FB\u6740\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5C04\u51FA4\u6839\u85E4\u523A\uFF0C\u6BCF\u6839\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u85E4\u523A\u7684\u4F24\u5BB3\u503C\u4ECE3\u63D0\u9AD8\u52304\r\n\u6EDA\u52A8\u5DE8\u77F3\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5C04\u51FA\u4E00\u5757\u6EDA\u52A8\u5DE8\u77F3\uFF0C\u51FB\u7A7F\u6240\u6709\u53F2\u83B1\u59C6\u5E76\u9020\u62104\u70B9\u4F24\u5BB3\u3002\u5DE8\u77F3\u7684\u76EE\u6807\u662F\u79BB\u70B9\u51FB\u53F2\u83B1\u59C6\u4F4D\u7F6E\u6700\u8FDC\u7684\u53F2\u83B1\u59C6\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u5DE8\u77F3\u7684\u4F24\u5BB3\u503C\u4ECE4\u63D0\u9AD8\u52305\r\n\u5F39\u7403\r\n\u51FB\u6740\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u5C04\u51FA\u4E00\u4E2A\u5F39\u7403\u3002\u8FD9\u4E2A\u5F39\u7403\u968F\u673A\u7784\u51C6\u4E00\u4E2A\u53F2\u83B1\u59C6\uFF0C\u5F39\u8DF31\u6B21\uFF08\u6709\u51E0\u7387\u5F39\u8DF33\u6B21\uFF09\u5E76\u9020\u62104\u70B9\u4F24\u5BB3\u3002\u4F7F\u75281\u4E2A\u5347\u7EA7\u69FD\uFF01\r\n\u5F39\u7403\u7684\u4F24\u5BB3\u503C\u4ECE4\u63D0\u9AD8\u52305\r\n\u6D41\u661F\r\n\u70B9\u51FB\u53F2\u83B1\u59C6\uFF1A\u6709\u51E0\u7387\u751F\u6210\u4E00\u9897\u4ECE\u5929\u800C\u964D\u7684\u6D41\u661F\uFF0C\u5BF9\u5927\u7247\u533A\u57DF\u5185\u7684\u53F2\u83B1\u59C6\u9020\u62107\u70B9\u4F24\u5BB3\u3002\u76EE\u6807\u5C04\u51FB\u548C\u5927\u53F2\u83B1\u59C6\r\n\u6D41\u661F\u4F24\u5BB3\u503C\u4ECE7\u63D0\u9AD8\u52309\r\n\u951A\u9489\u53D1\u5C04\u5668\r\n\u8349\u8393\u8F68\u9053\uFF1A\u6BCF\u79D2\u53D1\u5C04\u4E00\u679A\u951A\u9489\uFF0C4\u70B9\u4F24\u5BB3\u5E76\u8BA9\u53F2\u83B1\u59C6\u505C\u4E0B3\u79D2\u3002\u70B9\u51FB\u53F2\u83B1\u59C6\u4E5F\u6709\u51E0\u7387\u9489\u4F4F\u53F2\u83B1\u59C6\uFF01\r\n\u951A\u9489\u53D1\u5C04\u5668\u7684\u4F24\u5BB3\u4ECE4\u63D0\u9AD8\u52305\uFF0C\u951A\u9489\u53D1\u5C04\u5668\u5C04\u51FB\u65F6\u95F4\u4ECE1\u79D2\u51CF\u5C11\u52300.9\u79D2\uFF0C\u951A\u9489\u53D1\u5C04\u5668\u7729\u6655\u65F6\u95F4\u4ECE3\u79D2\u63D0\u9AD8\u52303.5\u79D2\r\n1\u7EA7\r\n\u5168\u5C4F
      \r\n(\u5F00\u542F)\r\n(\u5173\u95ED)\r\n\u80CC\u666F\r\n\u300A\u53F2\u83B1\u59C6\u7C89\u788E\u8005\u300B\u662F\u4E00\u6B3E\u6D88\u706D\u53F2\u83B1\u59C6\uFF0C\u4FDD\u62A4\u8349\u8393\u7684\u6E38\u620F\u3002\u9009\u62E9\u5347\u7EA7\uFF0C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\uFF0C\u633A\u8FC7\u81F4\u547D\u53F2\u83B1\u59C6\u4E00\u6CE2\u53C8\u4E00\u6CE2\u7684\u653B\u51FB\uFF01\r\n\u5728\u300A\u53F2\u83B1\u59C6\u7C89\u788E\u8005\u300B\u4E2D\uFF0C\u4F60\u7684\u4E3B\u8981\u76EE\u6807\u662F\u7528\u5149\u6807\u6D88\u706D\u53F2\u83B1\u59C6\uFF0C\u4FDD\u62A4\u8349\u8393\u3002\u8FD9\u4E9B\u53F2\u83B1\u59C6\u7684\u5927\u5C0F\u548C\u5F62\u72B6\u591A\u79CD\u591A\u6837\u3002\u6709\u7684\u5FEB\uFF0C\u6709\u7684\u6162\uFF0C\u6709\u7684\u80FD\u53D1\u5C04\u5B50\u5F39\uFF0C\u6709\u7684\u53C8\u5927\u53C8\u7B28\u91CD\uFF01\r\n\u53F2\u83B1\u59C6\u6709\u5C0F\u51E0\u7387\u4F1A\u6389\u843D\u91D1\u5E01\u3002\u8FD9\u4E9B\u91D1\u5E01\u53EF\u4EE5\u7528\u4E8E\u6C38\u4E45\u5347\u7EA7\uFF0C\u8FD9\u5C06\u4F7F\u4F60\u5728\u4E0B\u4E2A\u56DE\u5408\u4E2D\u66F4\u5F3A\u5927\uFF01\r\n\u300A\u53F2\u83B1\u59C6\u7C89\u788E\u8005\u300B\u6709\u591A\u79CD\u4E0D\u540C\u7684\u6E38\u620F\u6A21\u5F0F\uFF0C\u5176\u4E2D\u4E00\u4E9B\u66F4\u6709\u6311\u6218\u6027\u3002\u901A\u8FC7\u7EC4\u5408\u4E0D\u540C\u7684\u5347\u7EA7\u6765\u521B\u5EFA\u81EA\u5DF1\u7684\u73A9\u6CD5\u3002\r\n\u7279\u8272\u529F\u80FD\r\n\u5E38\u89C4\u6E38\u620F\u6A21\u5F0F:
      \u7B80\u5355\u3001\u666E\u901A\u548C\u56F0\u96BE\r\n\u6311\u6218\r\n\u5404\u79CDBoss\r\n30\u591A\u79CD\u5347\u7EA7\r\n\u5143\u8FDB\u5C55\r\n\u4E3B\u52A8\u80FD\u529B\r\n\u8FD8\u6709\u5927\u91CF\u88AB\u6D88\u706D\u7684\u53F2\u83B1\u59C6\uFF01\r\n\r\n\u300A\u53F2\u83B1\u59C6\u7C89\u788E\u8005\u300B\uFF1A"
