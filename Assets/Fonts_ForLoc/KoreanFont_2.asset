      \uC2AC\uB77C\uC784\uC744 \uD074\uB9AD\uD558\uC5EC \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD788\uC138\uC694.\r\nARIAL SDF\r\n\uB2E4\uC74C\r\n\uD50C\uB808\uC774!\r\n\uC5C5\uADF8\uB808\uC774\uB4DC
      1\uAC1C \uC120\uD0DD\r\n\uC624\uB978\uCABD \uD074\uB9AD\uD558\uC5EC \uC0AC\uC6A9
      \uAC00\uB2A5\uD55C \uC561\uD2F0\uBE0C \uB2A5\uB825\uC744 \uC0AC\uC6A9\uD558\uC138\uC694.\r\n\uC561\uD2F0\uBE0C
      \uC120\uD0DD\r\n\uAC8C\uC784 \uBAA8\uB4DC \uC120\uD0DD\r\n\uB538\uAE30\uAC00
      \uC8FD\uC5C8\uC5B4\uC694 :(\r\n\uC2B9\uB9AC!\r\n\uB370\uBAA8 \uC644\uB8CC!\r\n\uAC8C\uC784
      \uC885\uB8CC\r\n\r\n\uC5B8\uC5B4\r\n\uBA54\uC778 \uBA54\uB274\r\n\uC74C\uC545\r\n\uB044\uAE30\r\n\uD50C\uB808\uC774\r\n\uB2E4\uC2DC
      \uD50C\uB808\uC774\r\n\uB098\uAC00\uAE30\r\n\uB2E4\uC2DC \uC2DC\uC791\r\n\uD574\uC0C1\uB3C4\r\n\uC124\uC815\r\n\uC18C\uB9AC\r\n\uB370\uBAA8
      \uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.
      \uC815\uC2DD \uAC8C\uC784\uC744 \uC704\uC2DC\uB9AC\uC2A4\uD2B8\uC5D0 \uCD94\uAC00\uD574
      \uC8FC\uC138\uC694!\r\n\uD29C\uD1A0\uB9AC\uC5BC\r\n\uC5EC\uAE30\uC11C \uC704\uC2DC\uB9AC\uC2A4\uD2B8\uC5D0
      \uCD94\uAC00\uD558\uC138\uC694!\r\n\uCF1C\uAE30\r\n\uB2E4\uC2DC \uD50C\uB808\uC774\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC815\uC2DD \uAC8C\uC784\uC744 \uC704\uC2DC\uB9AC\uC2A4\uD2B8\uC5D0
      \uCD94\uAC00\uD558\uB294 \uAC83\uB3C4 \uACE0\uB824\uD574 \uC8FC\uC138\uC694!\uC6E8\uC774\uBE0C
      1\r\n\uD06C\uB9AC\uD2F0\uCEEC!\r\n\uB2EB\uAE30\r\n\uB4A4\uB85C\r\n\uD604\uC7AC
      \uC9C4\uD589 \uC911\uC778 \uAC8C\uC784\uC744 \uCD08\uAE30\uD654\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\r\n\uBA54\uC778
      \uBA54\uB274\uB85C \uB3CC\uC544\uAC00\uC2DC\uACA0\uC2B5\uB2C8\uAE4C? \uD604\uC7AC
      \uAC8C\uC784\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4.\r\n\uC77C\uBC18 \uAC8C\uC784
      \uBAA8\uB4DC: \uC26C\uC6C0 \uB09C\uC774\uB3C4\\n25 \uC6E8\uC774\uBE0C \uB3D9\uC548
      \uC0DD\uC874\uD558\uC138\uC694.\r\n\uC77C\uBC18 \uAC8C\uC784 \uBAA8\uB4DC:
      \uBCF4\uD1B5 \uB09C\uC774\uB3C4. \uC77C\uBD80 \uC2AC\uB77C\uC784\uC774 \uB354
      \uBE60\uB985\uB2C8\uB2E4. \uC2AC\uB77C\uC784 \uCD1D\uC54C\uC758 \uC18D\uB3C4\uAC00
      \uB354 \uBE60\uB985\uB2C8\uB2E4.\r\n\uC77C\uBC18 \uAC8C\uC784 \uBAA8\uB4DC:
      \uC5B4\uB824\uC6C0 \uB09C\uC774\uB3C4. \uBAA8\uB4E0 \uC2AC\uB77C\uC784\uC774
      \uB354 \uBE60\uB974\uACE0, \uBC1C\uC0AC \uC2AC\uB77C\uC784\uC758 \uACF5\uACA9
      \uBE48\uB3C4\uAC00 \uC99D\uAC00\uD558\uBA70, \uB538\uAE30\uAC00 \uD53C\uD574\uB97C
      \uC785\uC73C\uBA74 \uCCB4\uB825\uC774 1\uCE78 \uAC10\uC18C\uD569\uB2C8\uB2E4.\r\n\uD0C4\uD658
      \uC9C0\uC625 \uCC4C\uB9B0\uC9C0: \uBC1C\uC0AC \uC2AC\uB77C\uC784\uB9CC \uC0DD\uC131\uB429\uB2C8\uB2E4.
      \uD0C4\uD658 \uC18D\uB3C4\uAC00 \uB290\uB9BD\uB2C8\uB2E4. \uD0C4\uD658\uC744
      \uB9C9\uB294 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00 \uB098\uC62C \uD655\uB960\uC774
      \uB354 \uB192\uC2B5\uB2C8\uB2E4. 20 \uC6E8\uC774\uBE0C \uB3D9\uC548 \uC0DD\uC874\uD558\uC138\uC694.\r\n\uC18D\uB3C4\uAD11
      \uCC4C\uB9B0\uC9C0: \uBE60\uB978 \uC2AC\uB77C\uC784\uB9CC \uC0DD\uC131\uB429\uB2C8\uB2E4.
      \uC2AC\uB77C\uC784 \uC18D\uB3C4\uB97C \uB290\uB9AC\uAC8C \uD558\uB294 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00
      \uB098\uC62C \uD655\uB960\uC774 \uB354 \uB192\uC2B5\uB2C8\uB2E4. 25 \uC6E8\uC774\uBE0C
      \uB3D9\uC548 \uC0DD\uC874\uD558\uC138\uC694.\r\n\uC57D\uC810 \uCC4C\uB9B0\uC9C0:
      \uB538\uAE30\uAC00 1\uBC88\uC758 \uACF5\uACA9\uC73C\uB85C \uC8FD\uC2B5\uB2C8\uB2E4.
      \uBC29\uC5B4 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00 \uB098\uD0C0\uB098\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. 15 \uC6E8\uC774\uBE0C \uB3D9\uC548 \uC0DD\uC874\uD558\uC138\uC694.\r\n\uC881\uC740
      \uACF5\uAC04 \uCC4C\uB9B0\uC9C0: \uAC8C\uC784 \uC601\uC5ED\uC774 \uB354 \uC791\uC2B5\uB2C8\uB2E4.
      30 \uC6E8\uC774\uBE0C \uB3D9\uC548 \uC0DD\uC874\uD558\uC138\uC694.\r\n\uAD11\uB780
      \uCC4C\uB9B0\uC9C0: \uAE34 \uC6E8\uC774\uBE0C\uAC00 \uB2E8 1\uB9CC \uC788\uC2B5\uB2C8\uB2E4.
      15\uCD08\uB9C8\uB2E4 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00 \uB098\uD0C0\uB098\uC9C0\uB9CC
      \uAC8C\uC784\uC774 \uC77C\uC2DC \uC815\uC9C0\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4
      (\uC2AC\uB77C\uC784 \uCD1D\uC54C\uC740 \uBA48\uCDA5\uB2C8\uB2E4). 15\uBD84
      \uB3D9\uC548 \uC0DD\uC874\uD558\uC138\uC694.\r\n\uB370\uBAA8 \uBC84\uC804\uC5D0\uC11C\uB294
      \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n(\uC120\uD0DD\uB428)\r\n\uC2AC\uB77C\uC784
      \uCC98\uD615\r\n5\uB9C8\uB9AC\uC758 \uBB34\uC791\uC704 \uC2AC\uB77C\uC784\uC744
      \uC989\uC2DC \uCC98\uCE58\uD569\uB2C8\uB2E4. 4 \uC6E8\uC774\uBE0C \uC7AC\uCDA9\uC804\r\n\uAC15\uB825\uD55C
      \uD074\uB9AD\r\n\uBAA8\uB4E0 \uD074\uB9AD\uC774 \uCE58\uBA85\uD0C0 \uD074\uB9AD\uC774
      \uB418\uACE0, \uD074\uB9AD \uC7AC\uCDA9\uC804 \uC2DC\uAC04\uC774 3\uCD08 \uB3D9\uC548
      0.1\uCD08\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4. 4 \uC6E8\uC774\uBE0C \uC7AC\uCDA9\uC804\r\n\uD074\uB85C\uBC84\r\n\uB2E4\uC74C
      3\uCD08 \uB3D9\uC548 \"\uC2AC\uB77C\uC784 \uD074\uB9AD \uC2DC\" \uBC0F \"\uC2AC\uB77C\uC784
      \uC8FD\uC74C \uC2DC\" \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00 \uD56D\uC0C1 \uBC1C\uB3D9\uB429\uB2C8\uB2E4.
      3 \uC6E8\uC774\uBE0C \uC7AC\uCDA9\uC804\r\n\uB538\uAE30 \uBBF8\uB07C\r\n\uB538\uAE30
      \uBBF8\uB07C\uB97C \uC124\uCE58\uD569\uB2C8\uB2E4. \uBAA8\uB4E0 \uC2AC\uB77C\uC784\uC774
      \uBBF8\uB07C\uB97C \uBAA9\uD45C\uB85C \uD569\uB2C8\uB2E4. \uBBF8\uB07C\uB294
      \uD53C\uD574\uB97C \uC785\uC5B4 \uD55C \uBC88 \uC8FD\uC9C0 \uC54A\uB294 \uD55C
      3 \uC6E8\uC774\uBE0C \uB3D9\uC548 \uC9C0\uC18D\uB429\uB2C8\uB2E4. 6 \uC6E8\uC774\uBE0C
      \uC7AC\uCDA9\uC804\r\n\uD22C\uC0AC\uCCB4 \uAD11\uB780\r\n3\uCD08 \uB3D9\uC548
      \uCEE4\uC11C\uC5D0\uC11C 20\uAC1C\uC758 \uBB34\uC791\uC704 \uD22C\uC0AC\uCCB4\uB97C
      \uBC1C\uC0AC\uD569\uB2C8\uB2E4. 4 \uC6E8\uC774\uBE0C \uC7AC\uCDA9\uC804\r\n\uB300
      \uC2AC\uB77C\uC784 \uD0C4\uD658\r\n\uB538\uAE30\uC5D0\uC11C 15\uAC1C\uC758
      \uB300 \uC2AC\uB77C\uC784 \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4.
      \uAC01 \uD0C4\uD658\uC740 10\uC758 \uD53C\uD574\uB97C \uC785\uD788\uACE0 \uC801\uC744
      \uC989\uC0AC\uC2DC\uD0AC \uD655\uB960\uC774 10%\uC785\uB2C8\uB2E4 (\uBCF4\uC2A4
      \uC81C\uC678). 2 \uC6E8\uC774\uBE0C \uC7AC\uCDA9\uC804\r\n\uB808\uBCA8 2\r\n10
      \uC6E8\uC774\uBE0C\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4!\r\n\uD074\uB9AD
      \uCFE8\uB2E4\uC6B4\r\n\uD074\uB9AD \uCFE8\uB2E4\uC6B4 \uC2DC\uAC04\uC744 0.8\uCD08\uC5D0\uC11C
      0.7\uCD08\uB85C \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uD074\uB9AD \uB370\uBBF8\uC9C0\r\n\uD074\uB9AD
      \uB370\uBBF8\uC9C0\uB97C 10\uC5D0\uC11C 12\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uD06C\uB9AC\uD2F0\uCEEC
      \uB370\uBBF8\uC9C0\r\n\uD06C\uB9AC\uD2F0\uCEEC \uD655\uB960\uC744 0%\uC5D0\uC11C
      10%\uB85C, \uD06C\uB9AC\uD2F0\uCEEC \uB370\uBBF8\uC9C0\uB97C 0%\uC5D0\uC11C
      200%\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB538\uAE30 \uCCB4\uB825\r\n\uB538\uAE30\uC758
      \uCCB4\uB825\uC744 \uBC18 \uCE78 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB370\uBBF8\uC9C0
      \uC99D\uAC00\r\n\uBAA8\uB4E0 \uB370\uBBF8\uC9C0\uB97C 3% \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uBAA8\uB4E0
      \uB370\uBBF8\uC9C0\uB97C 3%\uC5D0\uC11C 6%\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uBB34\uB2F9\uBC8C\uB808\r\n\uBAA8\uB4E0
      \"\uC2AC\uB77C\uC784 \uC8FD\uC74C \uC2DC\" \uC5C5\uADF8\uB808\uC774\uB4DC\uC758
      \uBC1C\uB3D9 \uD655\uB960\uC744 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uCEE4\uC11C
      \uC2AC\uB798\uC2DC\r\n\uCEE4\uC11C\uB97C \uC2AC\uB77C\uC784 \uC704\uB85C \uC774\uB3D9\uC2DC\uCF1C
      \uBCA0\uC5B4\uBC84\uB9BD\uB2C8\uB2E4. \uAC01 \uC2AC\uB798\uC2DC\uB294 1\uC758
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC
      \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uCEE4\uC11C \uC2AC\uB798\uC2DC \uB370\uBBF8\uC9C0\uB97C
      1\uC5D0\uC11C 1.5\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uC885\uC774
      \uBE44\uD589\uAE30\r\n\uC2AC\uB77C\uC784 \uC8FD\uC74C \uC2DC: \uBB34\uC791\uC704
      \uC2AC\uB77C\uC784\uC5D0\uAC8C \uC885\uC774 \uBE44\uD589\uAE30\uB97C \uBC1C\uC0AC\uD558\uC5EC
      8\uC758 \uB370\uBBF8\uC9C0\uB97C \uC785\uD790 \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uC5C5\uADF8\uB808\uC774\uB4DC \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uC885\uC774
      \uBE44\uD589\uAE30 \uB370\uBBF8\uC9C0\uB97C 8\uC5D0\uC11C 11\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uD654\uC0B4\uBE44\r\n\uC2AC\uB77C\uC784
      \uD074\uB9AD \uC2DC: \uD558\uB298\uC5D0\uC11C 4-7\uAC1C\uC758 \uD654\uC0B4\uC774
      \uB5A8\uC5B4\uC838 \uBB34\uC791\uC704 \uC2AC\uB77C\uC784\uC744 \uACF5\uACA9\uD558\uACE0
      \uD654\uC0B4\uB2F9 4\uC758 \uB370\uBBF8\uC9C0\uB97C \uC785\uD790 \uD655\uB960\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC \uC2AC\uB86F 1\uAC1C
      \uC0AC\uC6A9!\r\n\uD654\uC0B4 \uB370\uBBF8\uC9C0\uB97C 4\uC5D0\uC11C 5\uB85C
      \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uCC0C\uB974\uB294 \uCE7C\r\n\uCEE4\uC11C
      \uADA4\uB3C4: \uCE7C\uC774 \uCEE4\uC11C \uC8FC\uC704\uB97C \uD68C\uC804\uD558\uBA70
      \uC2AC\uB77C\uC784\uC5D0\uAC8C 1\uC758 \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4.
      \uCE7C\uC740 3\uCD08\uB9C8\uB2E4 \uC2AC\uB77C\uC784\uC744 \uCC14\uB7EC 7\uC758
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uBA70, \uC2AC\uB77C\uC784\uC744 \uAD00\uD1B5\uD560
      \uAC00\uB2A5\uC131\uC774 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uCE7C \uB370\uBBF8\uC9C0\uB97C
      1\uC5D0\uC11C 1.2\uB85C, \uCE7C \uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0\uB97C
      7\uC5D0\uC11C 9\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB0AB\r\n\uC2AC\uB77C\uC784
      \uD074\uB9AD \uC2DC: 3\uCD08 \uB3D9\uC548 \uC9C0\uC18D\uB418\uB294 \uD68C\uC804\uD558\uB294
      \uB0AB\uC744 \uC0DD\uC131\uD558\uC5EC \uCD08\uB2F9 5\uC758 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD790 \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC
      \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uB0AB\uC758 \uCD08\uB2F9 \uB370\uBBF8\uC9C0\uB97C
      5\uC5D0\uC11C 6\uC73C\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB808\uC774\uC800
      \uCD1D\r\n\uB538\uAE30 \uADA4\uB3C4: \uB808\uC774\uC800 \uCD1D\uC774 \uB538\uAE30
      \uC8FC\uC704\uB97C \uD68C\uC804\uD558\uBA70 1.2\uCD08\uB9C8\uB2E4 \uB808\uC774\uC800\uB97C
      \uBC1C\uC0AC\uD558\uC5EC \uC2AC\uB77C\uC784\uC5D0\uAC8C 10\uC758 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD799\uB2C8\uB2E4. \uB808\uC774\uC800\uB294 \uAD00\uD1B5\uD558\uBA70
      \uC801\uC758 \uCD1D\uC54C\uC744 \uC0AD\uC81C\uD569\uB2C8\uB2E4. 7% \uD655\uB960\uB85C
      \uB450 \uBC88 \uBC1C\uC0AC\uD569\uB2C8\uB2E4.\r\n\uB808\uC774\uC800 \uB370\uBBF8\uC9C0\uB97C
      10\uC5D0\uC11C 12\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4. \uB808\uC774\uC800
      \uBC1C\uC0AC \uC2DC\uAC04\uC744 1.2\uCD08\uC5D0\uC11C 1\uCD08\uB85C \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4.
      \uB450 \uBC88 \uBC1C\uC0AC \uD655\uB960\uC744 7%\uC5D0\uC11C 11%\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uAC80\r\n\uC2AC\uB77C\uC784
      \uD074\uB9AD \uC2DC: \uBB34\uC791\uC704 \uC2AC\uB77C\uC784\uC744 6\uBC88 \uBCA0\uB294
      \uAC80\uC744 \uC0DD\uC131\uD558\uC5EC \uAC01 \uBCA0\uAE30\uB9C8\uB2E4 3\uC758
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD790 \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uC5C5\uADF8\uB808\uC774\uB4DC \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uAC80
      \uC2AC\uB798\uC2DC \uB370\uBBF8\uC9C0\uB97C 3\uC5D0\uC11C 4\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB3C5\uCE68\r\n\uC2AC\uB77C\uC784
      \uC8FD\uC74C \uC2DC: 4\uCD08 \uB3D9\uC548 8\uC758 \uB370\uBBF8\uC9C0 + 1\uC758
      \uB3C5 \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uB294 \uB3C5\uCE68\uC744 \uBC1C\uC0AC\uD560
      \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uB3C5\uCE68\uC740 \uB538\uAE30\uC5D0\uC11C
      \uAC00\uC7A5 \uBA40\uB9AC \uC788\uB294 \uC2AC\uB77C\uC784\uC744 \uBAA9\uD45C\uB85C
      \uD569\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uB3C5\uCE68
      \uB370\uBBF8\uC9C0\uB97C 8\uC5D0\uC11C 9\uB85C, \uB3C5 \uB370\uBBF8\uC9C0\uB97C
      1\uC5D0\uC11C 1.2\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB538\uAE30
      \uBC29\uD328\r\n\uB538\uAE30 \uADA4\uB3C4: \uBC29\uD328\uAC00 \uB538\uAE30
      \uC8FC\uC704\uB97C \uD68C\uC804\uD558\uBA70 \uB0A0\uC544\uC624\uB294 \uC2AC\uB77C\uC784
      \uCD1D\uC54C\uC744 \uB9C9\uC2B5\uB2C8\uB2E4.\r\n\uBC29\uD328\uC758 \uD06C\uAE30\uB97C
      \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uC1E0\uC0AC\uC2AC \uD3EC\uD0C4\r\n\uB538\uAE30
      \uADA4\uB3C4: \uC1E0\uC0AC\uC2AC\uC5D0 \uC5F0\uACB0\uB41C \uD3EC\uD0C4\uC774
      \uB538\uAE30 \uC8FC\uC704\uB97C \uD68C\uC804\uD558\uBA70 \uC2AC\uB77C\uC784\uC5D0\uAC8C
      4\uC758 \uB370\uBBF8\uC9C0\uB97C \uC785\uD799\uB2C8\uB2E4.\r\n\uC1E0\uC0AC\uC2AC
      \uD3EC\uD0C4 \uB370\uBBF8\uC9C0\uB97C 4\uC5D0\uC11C 5\uB85C \uC99D\uAC00\uC2DC\uD0A4\uACE0
      \uD68C\uC804 \uC18D\uB3C4\uB3C4 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB369\uAD74
      \uAC00\uC2DC\r\n\uC2AC\uB77C\uC784 \uC8FD\uC74C \uC2DC: \uAC01\uAC01 3\uC758
      \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uB294 4\uAC1C\uC758 \uB369\uAD74 \uAC00\uC2DC\uB97C
      \uBC1C\uC0AC\uD560 \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC
      \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uAC00\uC2DC \uB370\uBBF8\uC9C0\uB97C
      3\uC5D0\uC11C 4\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uAD74\uB7EC\uAC00\uB294
      \uBC14\uC704\r\n\uC2AC\uB77C\uC784 \uD074\uB9AD \uC2DC: \uBAA8\uB4E0 \uC2AC\uB77C\uC784\uC744
      \uAD00\uD1B5\uD558\uB294 \uAD74\uB7EC\uAC00\uB294 \uBC14\uC704\uB97C \uBC1C\uC0AC\uD558\uC5EC
      4\uC758 \uB370\uBBF8\uC9C0\uB97C \uC785\uD790 \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uBC14\uC704\uB294 \uC2AC\uB77C\uC784 \uD074\uB9AD \uC704\uCE58\uC5D0\uC11C
      \uAC00\uC7A5 \uBA40\uB9AC \uC788\uB294 \uC2AC\uB77C\uC784\uC744 \uBAA9\uD45C\uB85C
      \uD569\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uBC14\uC704
      \uB370\uBBF8\uC9C0\uB97C 4\uC5D0\uC11C 5\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uD1B5\uD1B5\uBCFC\r\n\uC2AC\uB77C\uC784
      \uC8FD\uC74C \uC2DC: \uBB34\uC791\uC704 \uC2AC\uB77C\uC784\uC744 \uBAA9\uD45C\uB85C
      \uD558\uACE0 1\uBC88 \uD295\uAE30\uBA70 3\uBC88 \uD295\uAE38 \uD655\uB960\uC774
      \uC788\uB294 \uD1B5\uD1B5\uBCFC\uC744 \uBC1C\uC0AC\uD558\uC5EC 4\uC758 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD790 \uD655\uB960\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC
      \uC2AC\uB86F 1\uAC1C \uC0AC\uC6A9!\r\n\uD1B5\uD1B5\uBCFC \uB370\uBBF8\uC9C0\uB97C
      4\uC5D0\uC11C 5\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uC6B4\uC11D\r\n\uC2AC\uB77C\uC784
      \uD074\uB9AD \uC2DC: \uD558\uB298\uC5D0\uC11C \uB5A8\uC5B4\uC838 \uB113\uC740
      \uC601\uC5ED\uC758 \uC2AC\uB77C\uC784\uC5D0\uAC8C 7\uC758 \uB370\uBBF8\uC9C0\uB97C
      \uC785\uD788\uB294 \uC6B4\uC11D\uC744 \uC0DD\uC131\uD560 \uD655\uB960\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uBC1C\uC0AC \uC2AC\uB77C\uC784\uACFC \uD070 \uC2AC\uB77C\uC784\uC744
      \uBAA9\uD45C\uB85C \uD569\uB2C8\uB2E4.\r\n\uC6B4\uC11D \uB370\uBBF8\uC9C0\uB97C
      7\uC5D0\uC11C 9\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uC2A4\uD14C\uC774\uD50C\uB7EC\r\n\uB538\uAE30
      \uADA4\uB3C4: 1\uCD08\uB9C8\uB2E4 \uC2A4\uD14C\uC774\uD50C\uC744 \uBC1C\uC0AC\uD558\uC5EC
      4\uC758 \uB370\uBBF8\uC9C0\uB97C \uC785\uD788\uACE0 \uC2AC\uB77C\uC784\uC744
      3\uCD08 \uB3D9\uC548 \uBA48\uCD94\uAC8C \uD569\uB2C8\uB2E4. \uC2AC\uB77C\uC784\uC744
      \uD074\uB9AD\uD558\uBA74 \uC2AC\uB77C\uC784\uC744 \uC2A4\uD14C\uC774\uD50C\uB85C
      \uACE0\uC815\uD560 \uD655\uB960\uB3C4 \uC788\uC2B5\uB2C8\uB2E4!\r\n\uC2A4\uD14C\uC774\uD50C\uB7EC
      \uB370\uBBF8\uC9C0\uB97C 4\uC5D0\uC11C 5\uB85C \uC99D\uAC00\uC2DC\uD0A4\uACE0,
      \uC2A4\uD14C\uC774\uD50C\uB7EC \uBC1C\uC0AC \uC2DC\uAC04\uC744 1\uCD08\uC5D0\uC11C
      0.9\uCD08\uB85C \uAC10\uC18C\uC2DC\uD0A4\uBA70, \uC2A4\uD14C\uC774\uD50C\uB7EC
      \uAE30\uC808 \uC2DC\uAC04\uC744 3\uCD08\uC5D0\uC11C 3.5\uCD08\uB85C \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\r\n\uB808\uBCA8
      1\r\n\uC804\uCCB4 \uD654\uBA74\r\n(\uCF1C\uC9D0)\r\n(\uAEBC\uC9D0)\r\n\uBC30\uACBD\r\n\uC2AC\uB77C\uC784
      \uC2A4\uCFFC\uC154\uB294 \uC2AC\uB77C\uC784\uC744 \uB20C\uB7EC \uB538\uAE30\uB97C
      \uBCF4\uD638\uD574\uC57C \uD558\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uC120\uD0DD\uD558\uACE0 \uB354 \uAC15\uB825\uD574\uC838\uC11C \uCE58\uBA85\uC801\uC778
      \uC2AC\uB77C\uC784\uC758 \uC6E8\uC774\uBE0C\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC73C\uC138\uC694!\r\n\uC2AC\uB77C\uC784
      \uC2A4\uCFFC\uC154\uC5D0\uC11C \uC5EC\uB7EC\uBD84\uC758 \uC8FC\uC694 \uBAA9\uD45C\uB294
      \uCEE4\uC11C\uB85C \uC2AC\uB77C\uC784\uC744 \uB20C\uB7EC \uB538\uAE30\uB97C
      \uBCF4\uD638\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4. \uC2AC\uB77C\uC784\uC740
      \uB2E4\uC591\uD55C \uD06C\uAE30\uC640 \uBAA8\uC591\uC73C\uB85C \uB098\uD0C0\uB0A9\uB2C8\uB2E4.
      \uC5B4\uB5A4 \uC2AC\uB77C\uC784\uC740 \uBE60\uB974\uACE0, \uC5B4\uB5A4 \uC2AC\uB77C\uC784\uC740
      \uB290\uB9AC\uACE0, \uC5B4\uB5A4 \uC2AC\uB77C\uC784\uC740 \uCD1D\uC54C\uC744
      \uC3D8\uACE0, \uC5B4\uB5A4 \uC2AC\uB77C\uC784\uC740 \uD06C\uACE0 \uB369\uCE58\uAC00
      \uD07D\uB2C8\uB2E4!\r\n\uC2AC\uB77C\uC784\uC740 \uC791\uC740 \uD655\uB960\uB85C
      \uAE08\uD654\uB97C \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4. \uC774 \uAE08\uD654\uB294
      \uB2E4\uC74C \uAC8C\uC784\uC5D0\uC11C \uB354 \uAC15\uB825\uD574\uC9C8 \uC218
      \uC788\uB294 \uC601\uAD6C \uC5C5\uADF8\uB808\uC774\uB4DC\uC5D0 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4!\r\n\uC2AC\uB77C\uC784 \uC2A4\uCFFC\uC154\uC5D0\uB294
      \uB2E4\uC591\uD55C \uD50C\uB808\uC774 \uAC00\uB2A5\uD55C \uAC8C\uC784 \uBAA8\uB4DC\uAC00
      \uC788\uC73C\uBA70, \uC5B4\uB5A4 \uBAA8\uB4DC\uB294 \uB2E4\uB978 \uBAA8\uB4DC\uBCF4\uB2E4
      \uB354 \uC5B4\uB835\uC2B5\uB2C8\uB2E4. \uB2E4\uC591\uD55C \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uC870\uD569\uD558\uC5EC \uC790\uC2E0\uB9CC\uC758 \uBE4C\uB4DC\uB97C \uB9CC\uB4DC\uC138\uC694.\r\n\uC8FC\uC694
      \uD2B9\uC9D5\r\n\uC77C\uBC18 \uAC8C\uC784 \uBAA8\uB4DC: \uC26C\uC6C0, \uBCF4\uD1B5,
      \uC5B4\uB824\uC6C0 \uB09C\uC774\uB3C4\r\n\uCC4C\uB9B0\uC9C0\r\n\uBCF4\uC2A4\r\n30\uAC1C
      \uC774\uC0C1\uC758 \uC5C5\uADF8\uB808\uC774\uB4DC\r\n\uBA54\uD0C0 \uC9C4\uD589\r\n\uC561\uD2F0\uBE0C
      \uB2A5\uB825\r\n\uADF8\uB9AC\uACE0 \uBC14\uAE00\uBC14\uAE00\uD55C \uCC0C\uADF8\uB7EC\uC9C4
